# Google sign-in through Supabase (docs/google-sign-in.md). Copy to .env.local for `npm run dev`;
# on Vercel, add the same two under Settings > Environment Variables.
# Both are public by design (Row Level Security guards the data). Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
